{
    "name": "mywallist",
    "version": "0.0.1",
    "author": "delayhsiao <fuck@fackyou.org>",
    "description": "An electron-vue project with Vue 3 + TypeScript + Vite",
    "license": null,
    "main": "dist-electron/index.js",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build && electron-builder",
        "build:dir": "vue-tsc --noEmit && vite build && electron-builder --dir",
        "preview": "vite preview",
        "electron:build": "vite build && electron-builder",
        "electron:dev": "vite",
        "type-check": "vue-tsc --noEmit"
    },
    "build": {
        "productName": "mywallist",
        "appId": "org.fackyou.mywallist",
        "directories": {
            "output": "release/${version}"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*"
        ],
        "dmg": {
            "contents": [
                {
                    "x": 410,
                    "y": 150,
                    "type": "link",
                    "path": "/Applications"
                },
                {
                    "x": 130,
                    "y": 150,
                    "type": "file"
                }
            ]
        },
        "mac": {
            "icon": "build/icons/icon.icns"
        },
        "win": {
            "icon": "build/icons/icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "linux": {
            "icon": "build/icons",
            "target": [
                "AppImage",
                "deb"
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    },
    "dependencies": {
        "vue": "^3.5.13",
        "axios": "^1.7.9",
        "vue-router": "^4.5.0",
        "pinia": "^2.3.0",
        "pinia-plugin-persistedstate": "^4.2.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.5",
        "@vitejs/plugin-vue": "^5.2.1",
        "electron": "^33.3.1",
        "electron-builder": "^25.1.8",
        "typescript": "^5.7.2",
        "vite": "^6.0.7",
        "vite-plugin-electron": "^0.29.0",
        "vite-plugin-electron-renderer": "^0.14.6",
        "vue-tsc": "^2.2.0"
    }
}
